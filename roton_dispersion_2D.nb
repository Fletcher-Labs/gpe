Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"1", "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "/", "x"}], ")"}], " ", "/", 
       RowBox[{"(", 
        RowBox[{"1", "/", 
         RowBox[{"x", "^", "2"}]}], ")"}]}], " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "/", "x"}], ")"}], "^", 
          RowBox[{"(", 
           RowBox[{"1", "/", "2"}], ")"}]}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"1", "/", 
         RowBox[{"x", "^", 
          RowBox[{"(", 
           RowBox[{"1", "/", "4"}], ")"}]}]}], ")"}]}]}], ")"}]}], ",", " ", 
   RowBox[{"Assumptions", "->", 
    RowBox[{"x", ">", "0"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.981474757001667*^9, 3.981474795850762*^9}, {
  3.981474930519568*^9, 3.9814749449433613`*^9}},
 CellLabel->
  "In[15297]:=",ExpressionUUID->"d4454c2a-e4a4-4739-87c0-b7d3610f837f"],

Cell[BoxData[
 FractionBox["1", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"1", "+", 
     SqrtBox["x"]}], ")"}], " ", 
   SuperscriptBox["x", 
    RowBox[{"3", "/", "4"}]]}]]], "Output",
 CellChangeTimes->{{3.981474762139359*^9, 3.981474796174561*^9}, {
  3.981474931028368*^9, 3.981474945177477*^9}},
 CellLabel->
  "Out[15297]=",ExpressionUUID->"43746a0e-1fbe-4801-9dec-bf83a086d7fc"]
}, Open  ]],

